# Generated by CMake -- do not edit.
# Installs the already compiled pyonika package into a Python environment:
#   pip install @CMAKE_INSTALL_PREFIX@/python
[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "pyonika"
version = "@PROJECT_VERSION@"
description = "Python interface to the onika simulation platform"
requires-python = "==@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@.*"
dependencies = ["numpy"]

[tool.setuptools]
packages = ["pyonika", "onika_mcp"]

[tool.setuptools.package-data]
pyonika = ["*.so", "*.pyd"]
